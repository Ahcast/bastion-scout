[Unit]
Description=Bastion licitaciones BID JICA UCP
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=bastion
WorkingDirectory=/opt/bastion-scout
LoadCredential=ai-api-key:/home/ubuntu/.config/bastion-scout/ai-api-key
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 --no-fork /var/lib/bastion-scout/pipeline.lock /opt/bastion-scout/.venv/bin/python /opt/bastion-scout/scout_licitaciones.py --output-dir /var/lib/bastion-scout/licitaciones --timeout-minutes 45 --config /opt/bastion-scout/config.json
SuccessExitStatus=2 75
TimeoutStartSec=50min
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/.config/bastion-scout/rfq-clasificacion
ReadWritePaths=/var/lib/bastion-scout/licitaciones
UMask=0027
